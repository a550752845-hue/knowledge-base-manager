{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/a550752845-hue/knowledge-base-manager/source-registry-row.schema.json",
  "title": "Knowledge Base Manager source registry row",
  "type": "object",
  "required": ["source_id", "title", "source_type", "sensitivity", "status"],
  "properties": {
    "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"},
    "title": {"type": "string", "minLength": 1},
    "source_type": {"type": "string", "minLength": 1},
    "author_or_owner": {"type": "string"},
    "publication_or_platform": {"type": "string"},
    "original_date": {"type": "string"},
    "captured_at": {"type": "string"},
    "source_url": {"type": "string"},
    "external_id": {"type": "string"},
    "preferred_read_path": {"type": "string"},
    "all_known_paths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "representations": {
      "type": "array",
      "items": {"type": ["string", "object"]}
    },
    "versions": {
      "type": "array",
      "items": {"type": ["string", "object"]}
    },
    "content_hash": {"type": "string"},
    "rights_or_permission": {"type": "string"},
    "sensitivity": {"enum": ["public", "internal", "private", "restricted"]},
    "status": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
