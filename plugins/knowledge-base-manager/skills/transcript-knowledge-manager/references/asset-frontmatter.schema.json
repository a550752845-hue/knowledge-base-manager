{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/a550752845-hue/knowledge-base-manager/asset-frontmatter.schema.json",
  "title": "Knowledge Base Manager asset frontmatter",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "type",
    "knowledge_role",
    "truth_status",
    "preservation",
    "reuse_mode",
    "status",
    "scope_type",
    "topics",
    "confidence",
    "maturity",
    "time_sensitivity",
    "sensitivity",
    "created",
    "updated"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"},
    "type": {"type": "string", "minLength": 1},
    "knowledge_role": {
      "enum": ["source", "logic-map", "fact", "claim", "principle", "model", "procedure", "talk-track", "evidence", "source-profile", "output", "management"]
    },
    "truth_status": {
      "enum": ["source-record", "source-claim", "verified-fact", "model-synthesis", "user-preference", "generated"]
    },
    "preservation": {"enum": ["exact", "anchored", "normalized", "derived"]},
    "reuse_mode": {"enum": ["quote-only", "analyze-only", "adapt-required", "direct-use", "reference-only", "do-not-use"]},
    "status": {"enum": ["draft", "active", "pending-review", "approved", "deprecated", "archived"]},
    "scope_type": {"enum": ["general", "industry", "responsibility", "cross-domain", "project"]},
    "primary_domain": {"type": "string"},
    "domains": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "industries": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "responsibilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "topics": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "retrieval_queries": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "audiences": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "languages": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "source_id": {"type": "string", "minLength": 1},
    "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "source_anchors": {"type": "array"},
    "confidence": {"enum": ["low", "medium", "high"]},
    "maturity": {"enum": ["seed", "candidate", "stable", "core"]},
    "evidence_strength": {"enum": ["weak", "moderate", "strong"]},
    "time_sensitivity": {"enum": ["low", "medium", "high"]},
    "sensitivity": {"enum": ["public", "internal", "private", "restricted"]},
    "created": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "updated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "last_verified": {"type": "string", "pattern": "^(?:|\\d{4}-\\d{2}-\\d{2})$"},
    "summary": {"type": "string"},
    "variables": {"type": "array"},
    "audience": {"type": "string", "minLength": 1},
    "scenario": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "boundary": {"type": "string", "minLength": 1},
    "compliance_risk": {"type": "string", "minLength": 1},
    "rights_or_permission": {"type": "string", "minLength": 1},
    "verification_method": {"type": "string", "minLength": 1},
    "verification_sources": {"type": "array", "minItems": 1},
    "anonymization_status": {"enum": ["not-reviewed", "pending-review", "approved", "rejected"]},
    "declassification_status": {"enum": ["not-reviewed", "pending-review", "approved", "rejected"]},
    "privacy_reviewed_by": {"type": "string", "minLength": 1},
    "privacy_review_reason": {"type": "string", "minLength": 1},
    "privacy_reviewed_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "tested_status": {"enum": ["untested", "reviewed", "tested"]},
    "promotion_status": {"enum": ["not-reviewed", "pending-review", "approved", "promoted", "rejected"]}
  },
  "allOf": [
    {
      "if": {"properties": {"knowledge_role": {"const": "logic-map"}}, "required": ["knowledge_role"]},
      "then": {
        "properties": {
          "truth_status": {"const": "source-claim"},
          "preservation": {"const": "derived"},
          "reuse_mode": {"const": "analyze-only"}
        },
        "required": ["source_ids"]
      }
    },
    {
      "if": {"properties": {"truth_status": {"const": "verified-fact"}}, "required": ["truth_status"]},
      "then": {
        "required": ["last_verified"],
        "anyOf": [{"required": ["verification_method"]}, {"required": ["verification_sources"]}]
      }
    },
    {
      "if": {"properties": {"reuse_mode": {"const": "direct-use"}}, "required": ["reuse_mode"]},
      "then": {
        "properties": {"status": {"const": "approved"}, "tested_status": {"enum": ["reviewed", "tested"]}},
        "required": ["audience", "scenario", "goal", "variables", "boundary", "compliance_risk", "rights_or_permission", "tested_status", "last_verified"]
      }
    },
    {
      "if": {
        "anyOf": [
          {"properties": {"anonymization_status": {"const": "approved"}}, "required": ["anonymization_status"]},
          {"properties": {"declassification_status": {"const": "approved"}}, "required": ["declassification_status"]}
        ]
      },
      "then": {
        "required": ["privacy_reviewed_by", "privacy_review_reason", "privacy_reviewed_at"]
      }
    }
  ],
  "additionalProperties": true
}
